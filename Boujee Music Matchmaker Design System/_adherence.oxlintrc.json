{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "ui_kits/landing/**",
              "ui_kits/quiz/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Amsterdam Signature))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Amsterdam Signature."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|onInk)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'onInk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeartToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|size|onClick|as|key|ref|className|style|children)$/]",
        "message": "<HeartToggle> doesn't accept that prop. Declared props: selected, size, onClick, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeartToggle'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|span)$/]",
        "message": "<HeartToggle> as must be one of 'button' | 'span'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|placeholder|value|onChange|error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, type, placeholder, value, onChange, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadingBeat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<LoadingBeat> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:percent|size|key|ref|className|style|children)$/]",
        "message": "<MatchBadge> doesn't accept that prop. Declared props: percent, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|sublabel|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<OptionCard> doesn't accept that prop. Declared props: label, sublabel, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:progress|size|closed|key|ref|className|style|children)$/]",
        "message": "<ProgressRing> doesn't accept that prop. Declared props: progress, size, closed."
      },
      {
        "selector": "JSXOpeningElement[name.name='SongRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|artist|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<SongRow> doesn't accept that prop. Declared props: title, artist, selected, onClick."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
